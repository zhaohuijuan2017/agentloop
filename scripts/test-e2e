#!/usr/bin/env bash
# 门禁: e2e_tests —— 前端关键路径 A12/A13 (SPEC §5.2, §11)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$ROOT/.tmp"
mkdir -p "$TMP"

export AGENTLOOP_DB="$TMP/e2e-agentloop.db"
rm -f "$AGENTLOOP_DB"

cd "$ROOT/backend"
PY=".venv/Scripts/python.exe"
[ -x "$PY" ] || PY=".venv/bin/python"

"$PY" -m uvicorn app.main:app --host 127.0.0.1 --port 8000 > "$TMP/backend-e2e.log" 2>&1 &
BACKEND_PID=$!

cd "$ROOT/frontend"
npm run dev -- --host 127.0.0.1 --port 5173 > "$TMP/frontend-e2e.log" 2>&1 &
FRONTEND_PID=$!

cleanup() {
  kill "$FRONTEND_PID" "$BACKEND_PID" >/dev/null 2>&1 || true
}
trap cleanup EXIT

wait_for_url() {
  local url="$1"
  for _ in {1..80}; do
    if command -v curl.exe >/dev/null 2>&1; then
      if curl.exe -fsS "$url" >/dev/null 2>&1; then
        return 0
      fi
    elif curl -fsS "$url" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  echo "Timed out waiting for $url" >&2
  return 1
}

wait_for_url "http://127.0.0.1:8000/api/loop-runs"
wait_for_url "http://127.0.0.1:5173"

npx playwright test --config ../e2e/playwright.config.js
